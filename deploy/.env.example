# deploy/.env 로 복사해서 값을 채운다. 이 파일에는 값을 넣지 않는다(커밋 대상).
# 텔레그램 (비워 두면 로그로만 알림)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 수집기 옵션 (생략 시 기본값)
COLLECTOR_EXCHANGES=
COLLECTOR_OB_INTERVAL=
COLLECTOR_STALE_SECONDS=
COLLECTOR_FLUSH_SECONDS=

# 호스트 디렉터리 (docker-compose.yml 기준 상대경로 또는 절대경로)
BTCQ_DATA_DIR=
BTCQ_RUNTIME_DIR=

# 거래소 API 키 (실거래/수수료 조회용 — 수집기는 사용하지 않음)
COINONE_ACCESS_TOKEN=
COINONE_SECRET_KEY=
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
